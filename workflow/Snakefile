# Step 3: Clustering within samples
# Output directory will be named {assembly_name}_clust_0.XX (ipyrad creates this automatically)
rule s3_clustering_within:
    message: "Step 3: Clustering within ({wildcards.assembly_name})"
    input:
        # This file is only written by merge_assemblies.
        # If merge reruns and rewrites {assembly}.json, this timestamp changes and
        # s3 reruns even though the JSON input itself is marked ancient().
        merge_done = "{project_dir}/{assembly_dir}/{assembly_name}/{assembly_name}.merge_done",
        # Use ancient() to ignore JSON timestamp - later steps (s4-s7) update the JSON
        # which would otherwise trigger unnecessary s3 reruns
        json = ancient("{project_dir}/{assembly_dir}/{assembly_name}/{assembly_name}.json"),
        reference = lambda w: get_reference_path(w) or [],
        reference_index = lambda w: get_reference_index(w) or []
    output:
        stats = "{project_dir}/{assembly_dir}/{assembly_name}/{assembly_name}_clust_{clust_thresh}/s3_cluster_stats.txt"
    params:
        project_config = get_assembly_step_config,
        threshold = get_clust_threshold,
        json_path = lambda w: f"{w.project_dir}/{w.assembly_dir}/{w.assembly_name}/{w.assembly_name}.json"
    threads: lambda w: get_threads("s3_clustering_within", w)
    resources:
        mem_mb = MEM_PER_CPU,
        runtime = config["resources"]["s3_clustering_within"]["runtime"]
    conda:
        CONDA_ENV
    wildcard_constraints:
        clust_thresh = r"0\.\d+"
    log:
        "{project_dir}/logs/clustering_within_{assembly_dir}_{assembly_name}_{clust_thresh}.log"
    benchmark:
        "{project_dir}/benchmarks/clustering_within_{assembly_dir}_{assembly_name}_{clust_thresh}.txt"
    script:
        "scripts/s3_clustering_within.py"

