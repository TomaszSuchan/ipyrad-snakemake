CONDA_ENV = "envs/ipyrad.yaml"
MEM_PER_CPU = lambda wildcards, threads: threads * config["resources"]["mem_per_cpu"]

# Validate and set defaults for optional QC resources
QC_STEPS = ['qc_whoa', 'qc_replicates', 'qc_vcftools_hardy', 'qc_hardy_summary', 'qc_shared_loci', 'qc_pca']
for step in QC_STEPS:
    if step not in config['resources']:
        config['resources'][step] = {
            'threads': 1,
            'runtime': config['resources']['s7_filter_export']['runtime']
        }

# ============================================================================
# Helper Functions - Project and Library Lookups
# ============================================================================
def get_project_from_path(path):
    """Extract project name from project_dir or a full output path."""
    normalized_path = normalize_project_dir(path)
    if normalized_path in PROJECT_DIR_TO_PROJECT:
        return PROJECT_DIR_TO_PROJECT[normalized_path]

    matches = []
    for project_dir, project_name in PROJECT_DIR_TO_PROJECT.items():
        if normalized_path.startswith(f"{project_dir}/"):
            matches.append((project_dir, project_name))

    if not matches:
        known_dirs = ", ".join(sorted(PROJECT_DIR_TO_PROJECT.keys()))
        raise ValueError(
            f"Could not determine project from path: {path}. "
            f"Known project_dir values: {known_dirs}"
        )

    matches.sort(key=lambda item: len(item[0]), reverse=True)
    return matches[0][1]

def get_project_from_library(library_id):
    """Find which project owns this library"""
    for proj_name, libraries in PROJECT_LIBRARIES.items():
        if library_id in libraries:
            return proj_name
    raise ValueError(f"Library {library_id} not found in any project")

def get_lib_info(wildcards):
    """Get library info for a wildcard set"""
    project = get_project_from_path(wildcards.project_dir)
    return PROJECT_LIBRARIES[project][wildcards.lib_id]

def get_profile_name(wildcards):
    """Get assembly profile name from wildcards or assembly mapping."""
    if hasattr(wildcards, "profile"):
        return wildcards.profile
    if hasattr(wildcards, "assembly_name"):
        project = get_project_from_path(wildcards.project_dir)
        mapped = ASSEMBLY_PROFILE_BY_PROJECT.get(project, {}).get(wildcards.assembly_name)
        if mapped:
            return mapped
    return "default"

def get_project_shared_ipyrad(project):
    """Get project-level settings used by shared demultiplex/filter."""
    return PROJECT_STEP12_CONFIGS[project]

def get_profile_config(wildcards):
    """Get merged project/profile config for assembly-specific rules."""
    project = get_project_from_path(wildcards.project_dir)
    profile = get_profile_name(wildcards)
    if profile not in PROJECT_PROFILES_CONFIGS[project]:
        raise ValueError(f"Profile '{profile}' not found for project '{project}'")
    return PROJECT_PROFILES_CONFIGS[project][profile]

def get_ipyrad_config(wildcards):
    """Get shared ipyrad config for demultiplex/filter steps."""
    project = get_project_from_path(wildcards.project_dir)
    return get_project_shared_ipyrad(project)

def get_proj_config(wildcards):
    """Backward-compatible alias used by scripts and params."""
    return get_profile_config(wildcards)

def get_assembly_step_config(wildcards):
    """
    Config slice for merge/s3-s7 full-assembly steps.
    Excludes unrelated keys (e.g., step7_subsets) so editing subset
    definitions does not invalidate and rerun early assembly rules.
    """
    cfg = get_profile_config(wildcards)
    return {
        "project_dir": cfg["project_dir"],
        "profile": cfg["profile"],
        "ipyrad": cfg["ipyrad"],
    }

def get_all_libraries(wildcards):
    """Get all libraries for a project"""
    project = get_project_from_path(wildcards.project_dir)
    return PROJECT_LIBRARIES[project]

# ============================================================================
# Helper Functions - Path List Builders
# ============================================================================

def get_library_jsons(wildcards):
    """Get all demultiplexed JSON files for a project"""
    libraries = get_all_libraries(wildcards)
    return [
        f"{wildcards.project_dir}/demultiplexed/{lib_id}/{info['name']}.json"
        for lib_id, info in libraries.items()
    ]

def get_library_s2_stats(wildcards):
    """Get all s2 stats files for a project"""
    libraries = get_all_libraries(wildcards)
    return [
        f"{wildcards.project_dir}/demultiplexed/{lib_id}/{info['name']}_edits/s2_rawedit_stats.txt"
        for lib_id, info in libraries.items()
    ]


def get_project_barcode_files(wildcards):
    """Barcode files for every library in the project."""
    libraries = get_all_libraries(wildcards)
    return [info["barcode"] for info in libraries.values()]

def get_optimization_stats(wildcards):
    """Get stats files for all optimization thresholds"""
    profile_cfg = get_profile_config(wildcards)
    return [
        f"{wildcards.project_dir}/optimization/{entry['assembly_name']}/"
        f"{entry['assembly_name']}_outfiles/{entry['assembly_name']}_stats.txt"
        for entry in get_optimization_threshold_entries(profile_cfg, wildcards.profile)
    ]

def get_optimization_loci(wildcards):
    """Get loci files for all optimization thresholds"""
    profile_cfg = get_profile_config(wildcards)
    return [
        f"{wildcards.project_dir}/optimization/{entry['assembly_name']}/"
        f"{entry['assembly_name']}_outfiles/{entry['assembly_name']}.loci"
        for entry in get_optimization_threshold_entries(profile_cfg, wildcards.profile)
    ]

def get_optimization_jsons(wildcards):
    """Get JSON files for all optimization thresholds"""
    profile_cfg = get_profile_config(wildcards)
    return [
        f"{wildcards.project_dir}/optimization/{entry['assembly_name']}/{entry['assembly_name']}.json"
        for entry in get_optimization_threshold_entries(profile_cfg, wildcards.profile)
    ]

def get_optimization_vcfs(wildcards):
    """Get VCF files for all optimization thresholds"""
    profile_cfg = get_profile_config(wildcards)
    return [
        f"{wildcards.project_dir}/optimization/{entry['assembly_name']}/"
        f"{entry['assembly_name']}_outfiles/{entry['assembly_name']}.vcf"
        for entry in get_optimization_threshold_entries(profile_cfg, wildcards.profile)
    ]

def get_optimization_hardy_reports(wildcards):
    """Get HWE files for all optimization thresholds (optional - use ancient() in rule)"""
    profile_cfg = get_profile_config(wildcards)
    return [
        f"{wildcards.project_dir}/optimization/{entry['assembly_name']}/"
        f"{entry['assembly_name']}_outfiles/qc/{entry['assembly_name']}.hardy.hwe"
        for entry in get_optimization_threshold_entries(profile_cfg, wildcards.profile)
    ]

def get_optimization_hardy_reports_ancient(wildcards):
    """Get HWE files for all optimization thresholds (required - triggers qc_vcftools_hardy)"""
    profile_cfg = get_profile_config(wildcards)
    # Don't use ancient() - we want qc_vcftools_hardy to run for optimization assemblies
    return [
        f"{wildcards.project_dir}/optimization/{entry['assembly_name']}/"
        f"{entry['assembly_name']}_outfiles/qc/{entry['assembly_name']}.hardy.hwe"
        for entry in get_optimization_threshold_entries(profile_cfg, wildcards.profile)
    ]

def get_optimization_whoa_reports(wildcards):
    """Get WHOA reports for all optimization thresholds."""
    profile_cfg = get_profile_config(wildcards)
    return [
        f"{wildcards.project_dir}/optimization/{entry['assembly_name']}/"
        f"{entry['assembly_name']}_outfiles/qc/{entry['assembly_name']}.whoa_report.txt"
        for entry in get_optimization_threshold_entries(profile_cfg, wildcards.profile)
    ]

def get_replicate_suffix(wildcards):
    """Single replicate suffix shared by optimization and QC rules."""
    cfg = get_profile_config(wildcards)
    qc = cfg.get("qc") or {}
    opt = cfg.get("optimization") or {}
    return qc.get("replicate_suffix") or opt.get("replicate_suffix", "_repl")

def get_whoa_min_bin(wildcards):
    """Lower WHOA bin size for small optimization VCFs."""
    cfg = get_profile_config(wildcards)
    qc = cfg.get("qc") or {}
    if getattr(wildcards, "assembly_dir", "") == "optimization":
        return qc.get("whoa_min_bin_optimization", 200)
    return qc.get("whoa_min_bin", 1000)

# ============================================================================
# Helper Functions - Resource and Thread Management
# ============================================================================

def get_clust_threshold(wildcards):
    """Get clustering threshold - checks optimization assemblies first, then project config
    Always returns a float (e.g., 0.85) for ipyrad, even if config uses integers (e.g., 85)"""
    project = get_project_from_path(wildcards.project_dir)
    profile = get_profile_name(wildcards)
    threshold_key = (project, profile, wildcards.assembly_name)
    if threshold_key in ASSEMBLY_THRESHOLDS:
        return ASSEMBLY_THRESHOLDS[threshold_key]
    project = get_project_from_path(wildcards.project_dir)
    profile_cfg = get_profile_config(wildcards)
    threshold = profile_cfg["ipyrad"]["clust_threshold"]
    return normalize_threshold_value(threshold, context=f"{project}.{profile}.ipyrad.clust_threshold")

def count_samples_from_json(json_path):
    """Read sample count from JSON file"""
    import json
    try:
        if os.path.exists(json_path):
            with open(json_path, 'r') as f:
                return len(json.load(f).get('samples', {}))
    except Exception:
        pass
    return None

def count_samples_from_barcode(barcode_path):
    """Count non-empty lines in barcode file"""
    try:
        if os.path.exists(barcode_path):
            with open(barcode_path, 'r') as f:
                return sum(1 for line in f if line.strip())
    except Exception:
        pass
    return None

def get_sample_count(step_name, wildcards):
    """Get sample count based on step type"""
    if not wildcards:
        return None

    # For s1: count from barcode file
    if step_name == "s1_demultiplexing" and hasattr(wildcards, 'lib_id'):
        project = get_project_from_path(wildcards.project_dir)
        barcode = PROJECT_LIBRARIES[project][wildcards.lib_id]['barcode']
        return count_samples_from_barcode(barcode)

    # For s2: count from s1 JSON
    elif hasattr(wildcards, 'lib_id'):
        json_path = f"{wildcards.project_dir}/demultiplexed/{wildcards.lib_id}/{wildcards.lib_name}.json"
        return count_samples_from_json(json_path)

    # For s3-s7: count from merged assembly JSON
    elif hasattr(wildcards, 'assembly_name'):
        json_path = f"{wildcards.project_dir}/{wildcards.assembly_dir}/{wildcards.assembly_name}/{wildcards.assembly_name}.json"
        return count_samples_from_json(json_path)

    return None

def get_threads(step_name, wildcards=None):
    """Get thread count for a step, handling dynamic 'samples' allocation"""
    thread_config = config["resources"][step_name]["threads"]
    max_cpus = config["resources"]["max_cpus"]

    # Static allocation
    if isinstance(thread_config, int):
        return min(thread_config, max_cpus)

    # Dynamic "samples" allocation
    if thread_config == "samples":
        n_samples = get_sample_count(step_name, wildcards)
        return min(n_samples or max_cpus, max_cpus)

    # Fallback
    return max_cpus

# Helper function to get reference genome path
def get_reference_path(wildcards):
    """Get reference genome path for a project/profile."""
    profile_cfg = get_profile_config(wildcards)
    ipyrad_params = profile_cfg["ipyrad"]

    # Only use reference if assembly_method is 'reference'
    if ipyrad_params.get('assembly_method', 'denovo') != 'reference':
        return None

    # Check if reference_sequence is directly specified
    if 'reference_sequence' in ipyrad_params and ipyrad_params['reference_sequence']:
        return ipyrad_params['reference_sequence']

    # Check if reference_assembly (NCBI accession) is specified
    if 'reference_assembly' in ipyrad_params and ipyrad_params['reference_assembly']:
        assembly_id = ipyrad_params['reference_assembly']
        profile = get_profile_name(wildcards)
        return f"{wildcards.project_dir}/reference/{profile}_{assembly_id}_genomic.fna"

    return None

# Helper function to get BWA index paths
def get_reference_index(wildcards):
    """Get BWA index path for a project (returns None if no reference)
    Returns the .bwt file as the primary output, but all index files are created together"""
    profile_cfg = get_profile_config(wildcards)
    ipyrad_params = profile_cfg["ipyrad"]

    # Only use reference if assembly_method is 'reference'
    if ipyrad_params.get('assembly_method', 'denovo') != 'reference':
        return None

    # Check if reference_assembly (NCBI accession) is specified
    if 'reference_assembly' in ipyrad_params and ipyrad_params['reference_assembly']:
        assembly_id = ipyrad_params['reference_assembly']
        profile = get_profile_name(wildcards)
        return f"{wildcards.project_dir}/reference/{profile}_{assembly_id}_genomic.fna.bwt"

    # If reference_sequence is directly specified, assume it's already indexed
    # (user is responsible for indexing external references)
    return None

# Download reference genome from NCBI using official datasets tool
rule download_reference:
    message: "Downloading reference genome {params.assembly_id} (dataset.zip)"
    output:
        dataset_zip = temp("{project_dir}/reference/{profile}_{assembly_id}_dataset.zip")
    params:
        assembly_id = lambda wildcards: wildcards.assembly_id
    threads: config["resources"]["download_reference"]["threads"]
    resources:
        mem_mb = MEM_PER_CPU,
        runtime = config["resources"]["download_reference"]["runtime"]
    conda:
        CONDA_ENV
    log:
        "{project_dir}/logs/download_reference_{profile}_{assembly_id}.log"
    shell:
        """
        datasets download genome accession {params.assembly_id} \
            --filename {output.dataset_zip} \
            2>&1 | tee -a {log}
        """

# Extract genomic.fna.gz from downloaded dataset
rule extract_reference:
    message: "Extracting genomic.fna.gz from dataset {wildcards.assembly_id}"
    input:
        dataset_zip = "{project_dir}/reference/{profile}_{assembly_id}_dataset.zip"
    output:
        fna_gz = "{project_dir}/reference/{profile}_{assembly_id}_genomic.fna.gz"
    threads: 1
    resources:
        mem_mb = MEM_PER_CPU,
        runtime = 10
    conda:
        CONDA_ENV
    log:
        "{project_dir}/logs/extract_reference_{profile}_{assembly_id}.log"
    shell:
        """
        set -euo pipefail
        TMP_DIR=$(mktemp -d)
        trap "rm -rf $TMP_DIR" EXIT
        
        unzip -q {input.dataset_zip} -d "$TMP_DIR"
        GENOME_FILE=$(find "$TMP_DIR" -name "*_genomic.fna*" | head -n 1)
        if [[ "$GENOME_FILE" == *.gz ]]; then
            mv "$GENOME_FILE" {output.fna_gz}
        else
            gzip -c "$GENOME_FILE" > {output.fna_gz}
        fi
        """

# Decompress the genomic.fna.gz to .fna
rule unzip_reference:
    message: "Decompressing reference genome {wildcards.assembly_id}.fna.gz"
    input:
        fna_gz = "{project_dir}/reference/{profile}_{assembly_id}_genomic.fna.gz"
    output:
        fna = "{project_dir}/reference/{profile}_{assembly_id}_genomic.fna"
    threads: 1
    resources:
        mem_mb = MEM_PER_CPU,
        runtime = 10
    conda:
        CONDA_ENV
    log:
        "{project_dir}/logs/unzip_reference_{profile}_{assembly_id}.log"
    shell:
        """
        gunzip -c {input.fna_gz} > {output.fna}
        """

# Index reference genome with BWA
rule index_reference:
    message: "Indexing reference genome {wildcards.assembly_id} with BWA"
    input:
        fna = "{project_dir}/reference/{profile}_{assembly_id}_genomic.fna"
    output:
        bwt = "{project_dir}/reference/{profile}_{assembly_id}_genomic.fna.bwt",
        amb = "{project_dir}/reference/{profile}_{assembly_id}_genomic.fna.amb",
        ann = "{project_dir}/reference/{profile}_{assembly_id}_genomic.fna.ann",
        pac = "{project_dir}/reference/{profile}_{assembly_id}_genomic.fna.pac",
        sa = "{project_dir}/reference/{profile}_{assembly_id}_genomic.fna.sa"
    threads: 1
    resources:
        index_lock = 1,  # Prevent parallel indexing of the same reference
        mem_mb = 30000,  # BWA indexing needs significant memory for large genomes
        runtime = 60
    conda:
        CONDA_ENV
    log:
        "{project_dir}/logs/index_reference_{profile}_{assembly_id}.log"
    shell:
        """
        set -euo pipefail
        bwa index {input.fna} 2>&1 | tee -a {log}
        """


