# Rule to generate simple QC report
rule unified_qc_report:
    message: "QC: Generating report for {wildcards.assembly_name}"
    input:
        vcf = "{project_dir}/{assembly_dir}/{assembly_name}/{assembly_name}_outfiles/{assembly_name}.vcf",
        loci = "{project_dir}/{assembly_dir}/{assembly_name}/{assembly_name}_outfiles/{assembly_name}.loci",
        hardy_hwe = "{project_dir}/{assembly_dir}/{assembly_name}/{assembly_name}_outfiles/qc/{assembly_name}.hardy.hwe",
        hardy_report = "{project_dir}/{assembly_dir}/{assembly_name}/{assembly_name}_outfiles/qc/{assembly_name}.hardy_report.txt",
        whoa_report = "{project_dir}/{assembly_dir}/{assembly_name}/{assembly_name}_outfiles/qc/{assembly_name}.whoa_report.txt",
        whoa_plot = "{project_dir}/{assembly_dir}/{assembly_name}/{assembly_name}_outfiles/qc/{assembly_name}.whoa_plot.pdf",
        replicate_report = "{project_dir}/{assembly_dir}/{assembly_name}/{assembly_name}_outfiles/qc/{assembly_name}.replicate_analysis.txt",
        shared_matrix = "{project_dir}/{assembly_dir}/{assembly_name}/{assembly_name}_outfiles/qc/{assembly_name}.shared_loci.tsv",
        shared_heatmap = "{project_dir}/{assembly_dir}/{assembly_name}/{assembly_name}_outfiles/qc/{assembly_name}.shared_loci_heatmap.pdf"
    output:
        report = "{project_dir}/{assembly_dir}/{assembly_name}/qc_report.txt",
        csv = "{project_dir}/{assembly_dir}/{assembly_name}/qc/qc_metrics.csv",
        pdf = "{project_dir}/{assembly_dir}/{assembly_name}/qc/supp_fig2_assembly_qc.pdf"
    params:
        project_config = get_proj_config,
        replicate_suffix = get_replicate_suffix
    threads: 1
    resources:
        mem_mb = MEM_PER_CPU,
        runtime = config["resources"]["s7_filter_export"]["runtime"]
    conda:
        CONDA_ENV
    log:
        "{project_dir}/logs/unified_qc_report_{assembly_dir}_{assembly_name}.log"
    benchmark:
        "{project_dir}/benchmarks/unified_qc_report_{assembly_dir}_{assembly_name}.txt"
    script:
        "scripts/report_final.py"

# Rule to compare optimization assemblies across thresholds
rule optimization_comparison:
    message: "Comparing optimization assemblies across thresholds"
    input:
        jsons = get_optimization_jsons,
        vcfs = get_optimization_vcfs,
        hardy_reports = get_optimization_hardy_reports_ancient,
        loci = get_optimization_loci,
        whoa_reports = get_optimization_whoa_reports
    output:
        csv = "{project_dir}/optimization/optimization_sample_stats_{profile}.csv",
        vcf_csv = "{project_dir}/optimization/optimization_sample_stats_vcf_{profile}.csv",
        hwe_csv = "{project_dir}/optimization/optimization_hwe_stats_{profile}.csv",
        replicate_csv = "{project_dir}/optimization/optimization_replicate_stats_{profile}.csv",
        pdf = "{project_dir}/optimization/optimization_comparison_{profile}.pdf",
        supp_pdf = "{project_dir}/optimization/supp_fig1_threshold_selection_{profile}.pdf"
    params:
        project_config = get_proj_config,
        thresholds = lambda w: get_proj_config(w)["optimization"]["thresholds"],
        replicate_suffix = get_replicate_suffix
    threads: 1
    resources:
        mem_mb = MEM_PER_CPU,
        runtime = config["resources"]["s7_filter_export"]["runtime"]
    conda:
        CONDA_ENV
    log:
        "{project_dir}/logs/optimization_comparison_{profile}.log"
    benchmark:
        "{project_dir}/benchmarks/optimization_comparison_{profile}.txt"
    script:
        "scripts/report_optimization.py"

