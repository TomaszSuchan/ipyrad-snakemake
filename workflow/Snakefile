    output:
        json = "{project_dir}/demultiplexed/{lib_id}/{lib_name}.json",
        stats = "{project_dir}/demultiplexed/{lib_id}/{lib_name}_fastqs/s1_demultiplex_stats.txt"
    params:
        library_name = lambda w: get_lib_info(w)['name'],
        library_id = lambda w: w.lib_id,
        raw_dir = lambda w: os.path.dirname(get_lib_info(w)['r1']),
        project_dir = lambda w: w.project_dir,
        demux_datatype = lambda w: get_ipyrad_config(w).get("datatype", "pair3rad"),
        restriction_overhang = lambda w: tuple(get_ipyrad_config(w)["restriction_overhang"])
    threads: lambda w: get_threads("s1_demultiplexing", w)
    resources:
        demux_lock = 1,
        mem_mb = MEM_PER_CPU,
        runtime = config["resources"]["s1_demultiplexing"]["runtime"]
    conda:
        CONDA_ENV
    log:
        "{project_dir}/logs/step1_{lib_id}_{lib_name}.log"
    benchmark:
        "{project_dir}/benchmarks/step1_{lib_id}_{lib_name}.txt"
    script:
        "scripts/s1_demultiplex.py"

