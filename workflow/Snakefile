# Snakefile for ipyrad pipeline - Multi-project support
# Run with: snakemake --cores 48 --use-conda
# Specify project: snakemake --cores 48 --use-conda --config project=Pmi_full
# Run all projects: snakemake --cores 48 --use-conda

import os
import re
from collections import defaultdict

def normalize_threshold_value(value, context="threshold"):
    """
    Normalize clustering threshold to proportion (0, 1].
    Accepts legacy percent-style ints/floats >1 (e.g., 85 -> 0.85).
    """
    try:
        t = float(value)
    except (TypeError, ValueError):
        raise ValueError(f"Invalid {context}: {value!r}. Must be numeric.")
    if t <= 0:
        raise ValueError(f"Invalid {context}: {value!r}. Must be > 0.")
    if t > 1.0:
        t = t / 100.0
    if t <= 0 or t > 1.0:
        raise ValueError(f"Invalid {context}: {value!r}. Normalized value must be in (0, 1].")
    return t


def threshold_to_token(value):
    """
    Convert threshold proportion to filesystem-safe token.
    Examples:
      0.85   -> "85"
      0.875  -> "87p5"
      0.8512 -> "85p12"
    """
    t = normalize_threshold_value(value)
    pct = t * 100.0
    rounded = round(pct, 6)
    if abs(rounded - round(rounded)) < 1e-9:
        return str(int(round(rounded)))
    return f"{rounded:.6f}".rstrip("0").rstrip(".").replace(".", "p")


def get_optimization_threshold_entries(profile_cfg, profile_name):
    """
    Return list of dicts:
      {"value": <float proportion>, "token": <name token>, "assembly_name": ...}
    """
    entries = []
    for t in profile_cfg["optimization"]["thresholds"]:
        t_norm = normalize_threshold_value(t)
        token = threshold_to_token(t_norm)
        entries.append({
            "value": t_norm,
            "token": token,
            "assembly_name": f"optimization_{profile_name}_{token}",
        })
    return entries

# Normalize project_dir values so path matching is robust.
def normalize_project_dir(path_value):
    """Normalize a project directory path and reject empty values."""
    if path_value is None:
        return None
    normalized = os.path.normpath(str(path_value).strip())
    if normalized in ("", "."):
        raise ValueError(f"Invalid project_dir value: {path_value!r}")
    return normalized.rstrip("/")


def merge_dicts(base, override):
    """Shallow dict merge where override keys win."""
    merged = dict(base or {})
    merged.update(dict(override or {}))
    return merged


def get_subset_outputs(project_name, profile_name, assembly_name, project_dir):
    """Get all subset output paths for a full assembly profile."""
    try:
        profile_cfg = PROJECT_PROFILES_CONFIGS[project_name][profile_name]
        subsets = profile_cfg.get("step7_subsets", {}) or {}
        outputs = []
        if subsets:
            for subset_name in subsets.keys():
                output_path = (
                    f"{project_dir}/full/{assembly_name}/"
                    f"{assembly_name}_{subset_name}_outfiles/{assembly_name}_{subset_name}.loci"
                )
                outputs.append(output_path)
        return outputs
    except Exception:
        return []


def get_subset_pca_outputs(project_name, profile_name, assembly_name, project_dir):
    """PCA QC plots for each step7 subset VCF."""
    subsets = PROJECT_PROFILES_CONFIGS[project_name][profile_name].get("step7_subsets", {}) or {}
    outputs = []
    for subset_name in subsets:
        stem = f"{assembly_name}_{subset_name}"
        qc_dir = f"{project_dir}/full/{assembly_name}/{stem}_outfiles/qc"
        outputs.extend([
            f"{qc_dir}/{stem}.pca_library.pdf",
            f"{qc_dir}/{stem}.pca_barcode.pdf",
            f"{qc_dir}/{stem}.pca_scores.tsv",
        ])
    return outputs

# Determine which project(s) to run
if "project" in config:
    # Single project specified on command line
    PROJECTS = [config["project"]]
    if config["project"] not in config["projects"]:
        raise ValueError(f"Project '{config['project']}' not found in config")
else:
    # Run all projects
    PROJECTS = list(config["projects"].keys())

# Validate and normalize project_dir values (default to project name if missing)
PROJECT_DIR_TO_PROJECT = {}
PROJECT_PROFILES = {}
PROJECT_PROFILES_CONFIGS = {}
PROJECT_STEP12_CONFIGS = {}
ASSEMBLY_PROFILE_BY_PROJECT = defaultdict(dict)
ASSEMBLY_THRESHOLDS = {}

for project_name in PROJECTS:
    proj_config = config["projects"][project_name]

    raw_project_dir = proj_config.get("project_dir", project_name)
    normalized_project_dir = normalize_project_dir(raw_project_dir)
    if normalized_project_dir in PROJECT_DIR_TO_PROJECT:
        other = PROJECT_DIR_TO_PROJECT[normalized_project_dir]
        raise ValueError(
            f"Duplicate project_dir '{normalized_project_dir}' for projects "
            f"'{other}' and '{project_name}'. Use unique output directories."
        )
    proj_config["project_dir"] = normalized_project_dir
    PROJECT_DIR_TO_PROJECT[normalized_project_dir] = project_name

    # New schema: projects.<name>.assemblies.<profile>
    if "assemblies" in proj_config:
        profiles_cfg = proj_config["assemblies"] or {}
        if not isinstance(profiles_cfg, dict) or not profiles_cfg:
            raise ValueError(
                f"Project '{project_name}' has invalid 'assemblies'. "
                "Expected non-empty mapping of profile -> config."
            )
        profile_names = list(profiles_cfg.keys())
    else:
        # Backward-compatible legacy schema
        profile_names = ["default"]
        profiles_cfg = {"default": {}}

    # Shared step1/2 settings: prefer explicit ipyrad_step12, fall back to legacy ipyrad.
    if "ipyrad_step12" in proj_config and "ipyrad" in proj_config:
        raise ValueError(
            f"Project '{project_name}' defines both 'ipyrad_step12' and 'ipyrad'. "
            "Use only one shared step1/2 config key."
        )
    project_base_ipyrad = dict(proj_config.get("ipyrad_step12", proj_config.get("ipyrad", {})) or {})
    project_base_ipyrad.setdefault("datatype", "pair3rad")
    project_base_workflow = proj_config.get("workflow", {})
    project_base_optimization = proj_config.get("optimization", {})
    project_base_qc = proj_config.get("qc", {})
    project_base_subsets = proj_config.get("step7_subsets", {})

    PROJECT_PROFILES[project_name] = profile_names
    PROJECT_PROFILES_CONFIGS[project_name] = {}
    PROJECT_STEP12_CONFIGS[project_name] = project_base_ipyrad

    for profile_name in profile_names:
        profile_raw = profiles_cfg[profile_name] or {}

        # In legacy mode, profile_raw may be empty; use project-level values.
        profile_ipyrad = merge_dicts(project_base_ipyrad, profile_raw.get("ipyrad", {}))
        profile_workflow = merge_dicts(project_base_workflow, profile_raw.get("workflow", {}))
        profile_optimization = merge_dicts(project_base_optimization, profile_raw.get("optimization", {}))
        profile_qc = merge_dicts(project_base_qc, profile_raw.get("qc", {}))
        profile_subsets = profile_raw.get("step7_subsets", project_base_subsets)

        # Assembly-stage datatype default should not silently inherit step1/2 datatype.
        if "datatype" not in (profile_raw.get("ipyrad", {}) or {}):
            profile_ipyrad["datatype"] = "pairddrad"
        if "assembly_method" not in profile_ipyrad:
            profile_ipyrad["assembly_method"] = "denovo"
        if "run_optimization" not in profile_workflow:
            profile_workflow["run_optimization"] = False
        if "run_full_assembly" not in profile_workflow:
            profile_workflow["run_full_assembly"] = False
        profile_optimization.setdefault("thresholds", [])
        profile_optimization["thresholds"] = [
            normalize_threshold_value(t, context=f"{project_name}.{profile_name}.optimization.thresholds")
            for t in profile_optimization["thresholds"]
        ]
        profile_optimization.setdefault("replicate_suffix", "_repl")
        profile_qc.setdefault("replicate_suffix", profile_optimization.get("replicate_suffix", "_repl"))

        PROJECT_PROFILES_CONFIGS[project_name][profile_name] = {
            "project_dir": normalized_project_dir,
            "profile": profile_name,
            "ipyrad": profile_ipyrad,
            "workflow": profile_workflow,
            "optimization": profile_optimization,
            "qc": profile_qc,
            "step7_subsets": profile_subsets or {},
        }

    # Shared demux/filter must be consistent across profiles in new schema.
    demux_keys = ("restriction_overhang", "filter_adapters", "filter_min_trim_len")
    if len(profile_names) > 1:
        first = PROJECT_PROFILES_CONFIGS[project_name][profile_names[0]]["ipyrad"]
        for pname in profile_names[1:]:
            curr = PROJECT_PROFILES_CONFIGS[project_name][pname]["ipyrad"]
            for key in demux_keys:
                if first.get(key) != curr.get(key):
                    raise ValueError(
                        f"Project '{project_name}' has conflicting ipyrad.{key} across profiles "
                        f"('{profile_names[0]}' vs '{pname}'). Shared demultiplex/filter requires identical values."
                    )

print(f"=== Running {len(PROJECTS)} project(s): {', '.join(PROJECTS)} ===\n")

# Build library information for each project
PROJECT_LIBRARIES = {}

for project_name in PROJECTS:
    proj_config = config["projects"][project_name]

    print(f"Project: {project_name}")
    print(f"  Output dir: {proj_config['project_dir']}")

    # Find libraries for this project
    library_files = {}
    for prefix in proj_config["library_prefixes"]:
        r1_path = f"{prefix}_R1_.fastq.gz"
        r2_path = f"{prefix}_R2_.fastq.gz"
        barcode_path = f"{prefix}.txt"
        lib_name = os.path.basename(prefix)

        # Verify files exist
        missing = []
        if not os.path.exists(r1_path):
            missing.append("R1")
        if not os.path.exists(r2_path):
            missing.append("R2")
        if not os.path.exists(barcode_path):
            missing.append("barcode")

        if missing:
            print(f"  WARNING: Skipping {prefix} - missing: {', '.join(missing)}")
            continue

        # Create safe ID
        safe_id = prefix.replace("/", "__")
        library_files[safe_id] = {
            "name": lib_name,
            "r1": r1_path,
            "r2": r2_path,
            "barcode": barcode_path
        }

    PROJECT_LIBRARIES[project_name] = library_files

    # Print summary
    libs_by_basename = defaultdict(list)
    for safe_id, info in library_files.items():
        libs_by_basename[info["name"]].append(info["r1"])

    print(f"  Found {len(library_files)} libraries:")
    for basename in sorted(libs_by_basename.keys()):
        file_list = libs_by_basename[basename]
        if len(file_list) > 1:
            print(f"    - {basename} ({len(file_list)} library copies - will merge)")
            for fpath in file_list:
                print(f"        {fpath}")
        else:
            print(f"    - {basename}")
            print(f"        {file_list[0]}")

    # Print workflow settings by profile
    for profile_name in PROJECT_PROFILES[project_name]:
        profile_cfg = PROJECT_PROFILES_CONFIGS[project_name][profile_name]
        proj_workflow = profile_cfg["workflow"]
        label = profile_name if profile_name != "default" else "legacy"
        if proj_workflow["run_optimization"]:
            opt = profile_cfg["optimization"]
            print(f"  Profile '{label}': OPTIMIZATION ({len(opt['thresholds'])} thresholds)")
        if proj_workflow["run_full_assembly"]:
            print(f"  Profile '{label}': FULL ASSEMBLY")

    print()

# Define final outputs for all projects
FINAL_OUTPUTS = []

for project_name in PROJECTS:
    proj_config = config["projects"][project_name]
    project_dir = proj_config["project_dir"]

    # Always export s2 stats summary after demultiplexing
    FINAL_OUTPUTS.append(f"{project_dir}/demultiplexed/s2_stats_by_sample.tsv")

    for profile_name in PROJECT_PROFILES[project_name]:
        profile_cfg = PROJECT_PROFILES_CONFIGS[project_name][profile_name]
        proj_workflow = profile_cfg["workflow"]

        if proj_workflow["run_optimization"]:
            for entry in get_optimization_threshold_entries(profile_cfg, profile_name):
                assembly_name = entry["assembly_name"]
                FINAL_OUTPUTS.append(
                    f"{project_dir}/optimization/{assembly_name}/"
                    f"{assembly_name}_outfiles/{assembly_name}.loci"
                )
                ASSEMBLY_THRESHOLDS[(project_name, profile_name, assembly_name)] = entry["value"]
                ASSEMBLY_PROFILE_BY_PROJECT[project_name][assembly_name] = profile_name
            FINAL_OUTPUTS.append(
                f"{project_dir}/optimization/optimization_sample_stats_{profile_name}.csv"
            )
            FINAL_OUTPUTS.append(
                f"{project_dir}/optimization/optimization_comparison_{profile_name}.pdf"
            )
            FINAL_OUTPUTS.append(
                f"{project_dir}/optimization/supp_fig1_threshold_selection_{profile_name}.pdf"
            )

        if proj_workflow["run_full_assembly"]:
            assembly_name = project_name if profile_name == "default" else f"{project_name}_{profile_name}"
            qc_dir = f"{project_dir}/full/{assembly_name}/{assembly_name}_outfiles/qc"
            FINAL_OUTPUTS.extend([
                f"{project_dir}/full/{assembly_name}/{assembly_name}_outfiles/{assembly_name}.loci",
                f"{project_dir}/full/{assembly_name}/qc_report.txt",
                f"{qc_dir}/{assembly_name}.shared_loci.tsv",
                f"{qc_dir}/{assembly_name}.shared_loci_heatmap.pdf",
                f"{qc_dir}/{assembly_name}.whoa_plot.pdf",
                f"{qc_dir}/{assembly_name}.whoa_report.txt",
                f"{qc_dir}/{assembly_name}.hardy_report.txt",
                f"{qc_dir}/{assembly_name}.replicate_analysis.txt",
                f"{project_dir}/full/{assembly_name}/qc/qc_metrics.csv",
                f"{project_dir}/full/{assembly_name}/qc/supp_fig2_assembly_qc.pdf",
            ])
            ASSEMBLY_PROFILE_BY_PROJECT[project_name][assembly_name] = profile_name
            subset_outputs = get_subset_outputs(project_name, profile_name, assembly_name, project_dir)
            if subset_outputs:
                FINAL_OUTPUTS.extend(subset_outputs)

    # If neither workflow enabled, just demultiplex and filter
    if all(
        not PROJECT_PROFILES_CONFIGS[project_name][p]["workflow"]["run_optimization"]
        and not PROJECT_PROFILES_CONFIGS[project_name][p]["workflow"]["run_full_assembly"]
        for p in PROJECT_PROFILES[project_name]
    ):
        for lib_id, lib_info in PROJECT_LIBRARIES[project_name].items():
            FINAL_OUTPUTS.append(
                f"{project_dir}/demultiplexed/{lib_id}/{lib_info['name']}_edits/s2_rawedit_stats.txt"
            )

print(f"FINAL_OUTPUTS has {len(FINAL_OUTPUTS)} files:")
for out in FINAL_OUTPUTS:
    print(f"  {out}")

rule all:
    input: FINAL_OUTPUTS

