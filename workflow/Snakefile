        "{project_dir}/logs/qc_replicates_{assembly_dir}_{assembly_name}.log"
    benchmark:
        "{project_dir}/benchmarks/qc_replicates_{assembly_dir}_{assembly_name}.txt"
    shell:
        """
        python workflow/scripts/vcf_analyze_replicates.py \
            --input {input.vcf} \
            --suffix {params.suffix} \
            --output {output.report} &> {log}
        """

# Rule to run vcftools Hardy-Weinberg equilibrium test
rule qc_vcftools_hardy:
    message: "QC: Hardy-Weinberg test for {wildcards.assembly_name}"
    input:
        vcf = "{project_dir}/{assembly_dir}/{assembly_name}/{assembly_name}_outfiles/{assembly_name}.vcf"
    output:
        hwe = "{project_dir}/{assembly_dir}/{assembly_name}/{assembly_name}_outfiles/qc/{assembly_name}.hardy.hwe"
    params:
        out_prefix = lambda w: f"{w.project_dir}/{w.assembly_dir}/{w.assembly_name}/{w.assembly_name}_outfiles/qc/{w.assembly_name}.hardy"
    threads: lambda w: get_threads("qc_vcftools_hardy", w)
    resources:
        mem_mb = MEM_PER_CPU,
        runtime = config["resources"]["qc_vcftools_hardy"]["runtime"]
    conda:
        CONDA_ENV
    log:
        "{project_dir}/logs/qc_vcftools_hardy_{assembly_dir}_{assembly_name}.log"
    benchmark:
        "{project_dir}/benchmarks/qc_vcftools_hardy_{assembly_dir}_{assembly_name}.txt"
    shell:
        """
        vcftools --vcf {input.vcf} \
            --hardy \
            --out {params.out_prefix} &> {log}
        """

# Rule to summarize Hardy-Weinberg equilibrium test results
# Only runs for full assemblies (not optimization - optimization_comparison handles that)
rule qc_hardy_summary:
    message: "QC: Hardy-Weinberg summary for {wildcards.assembly_name}"
    input:
        hwe = "{project_dir}/{assembly_dir}/{assembly_name}/{assembly_name}_outfiles/qc/{assembly_name}.hardy.hwe",
        vcf = "{project_dir}/{assembly_dir}/{assembly_name}/{assembly_name}_outfiles/{assembly_name}.vcf"
    output:
        report = "{project_dir}/{assembly_dir}/{assembly_name}/{assembly_name}_outfiles/qc/{assembly_name}.hardy_report.txt"
    params:
        assembly_dir = lambda w: w.assembly_dir
    threads: lambda w: get_threads("qc_hardy_summary", w)
    resources:
        mem_mb = MEM_PER_CPU,
        runtime = config["resources"]["qc_hardy_summary"]["runtime"]
    conda:
        CONDA_ENV
    log:
        "{project_dir}/logs/qc_hardy_summary_{assembly_dir}_{assembly_name}.log"
    benchmark:
        "{project_dir}/benchmarks/qc_hardy_summary_{assembly_dir}_{assembly_name}.txt"
    shell:
        """
        if [ "{params.assembly_dir}" != "full" ]; then
            echo "Skipping qc_hardy_summary for optimization assembly (handled by optimization_comparison)"
            touch {output.report}
        else
            python workflow/scripts/summarize_hardy.py \
                --input {input.hwe} \
                --vcf {input.vcf} \
                --output {output.report} &> {log}
        fi
        """


# PCA of the exported VCF, colored by barcode and by library.
# Points are samples. A star and the group name mark each group centroid.
# A sample merged across libraries is its own category, named by the joined pair.
rule qc_pca:
    message: "QC: PCA by barcode and library for {wildcards.assembly_name}"
    input:
        vcf = "{project_dir}/{assembly_dir}/{assembly_name}/{assembly_name}_outfiles/{assembly_name}.vcf",
        barcodes = get_project_barcode_files
    output:
        library_pdf = "{project_dir}/{assembly_dir}/{assembly_name}/{assembly_name}_outfiles/qc/{assembly_name}.pca_library.pdf",
        barcode_pdf = "{project_dir}/{assembly_dir}/{assembly_name}/{assembly_name}_outfiles/qc/{assembly_name}.pca_barcode.pdf",
        scores = "{project_dir}/{assembly_dir}/{assembly_name}/{assembly_name}_outfiles/qc/{assembly_name}.pca_scores.tsv"
    params:
        max_snps = lambda w: int(get_proj_config(w).get("qc", {}).get("pca_max_snps", 5000)),
        max_missing = lambda w: float(get_proj_config(w).get("qc", {}).get("pca_max_missing", 0.5)),
        min_maf = lambda w: float(get_proj_config(w).get("qc", {}).get("pca_min_maf", 0.05)),
        max_sample_missing = lambda w: float(get_proj_config(w).get("qc", {}).get("pca_max_sample_missing", 0.5)),
        seed = lambda w: int(get_proj_config(w).get("qc", {}).get("pca_seed", 1))
    threads: lambda w: get_threads("qc_pca", w)
    resources:
        mem_mb = MEM_PER_CPU,
        runtime = config["resources"]["qc_pca"]["runtime"]
    conda:
        CONDA_ENV
    log:
        "{project_dir}/logs/qc_pca_{assembly_dir}_{assembly_name}.log"
    benchmark:
        "{project_dir}/benchmarks/qc_pca_{assembly_dir}_{assembly_name}.txt"
    script:
        "scripts/qc_pca_batch.py"

rule qc_pca_subset:
    message: "QC: PCA by barcode and library for {wildcards.assembly_name}_{wildcards.subset_name}"
