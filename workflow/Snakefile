# Rule to install whoa package once (qc_whoa rule depends on this)
rule install_whoa:
    output:
        touch(".snakemake/whoa_installed")
    conda:
        CONDA_ENV
    shell:
        """
        Rscript -e 'if (!require("whoa", quietly = TRUE)) install.packages("whoa", repos = "https://cloud.r-project.org/")'
        """

# Rule to run whoa (Where's my Heterozygotes at?) QC analysis
rule qc_whoa:
    message: "QC: WHOA analysis for {wildcards.assembly_name}"
    input:
        vcf = "{project_dir}/{assembly_dir}/{assembly_name}/{assembly_name}_outfiles/{assembly_name}.vcf",
        whoa_installed = ".snakemake/whoa_installed"
    output:
        posteriors = "{project_dir}/{assembly_dir}/{assembly_name}/{assembly_name}_outfiles/qc/{assembly_name}.whoa_posteriors.rds",
        plot = "{project_dir}/{assembly_dir}/{assembly_name}/{assembly_name}_outfiles/qc/{assembly_name}.whoa_plot.pdf",
        report = "{project_dir}/{assembly_dir}/{assembly_name}/{assembly_name}_outfiles/qc/{assembly_name}.whoa_report.txt"
    params:
        project_config = get_proj_config,
        min_bin = get_whoa_min_bin
    threads: lambda w: get_threads("qc_whoa", w)
    resources:
        mem_mb = MEM_PER_CPU,
        runtime = config["resources"]["qc_whoa"]["runtime"]
    conda:
        CONDA_ENV
    log:
        "{project_dir}/logs/qc_whoa_{assembly_dir}_{assembly_name}.log"
    benchmark:
        "{project_dir}/benchmarks/qc_whoa_{assembly_dir}_{assembly_name}.txt"
    shell:
        """
        Rscript workflow/scripts/run_whoa_qc.R \
            --vcf {input.vcf} \
            --posteriors {output.posteriors} \
            --plot {output.plot} \
            --report {output.report} \
            --min-bin {params.min_bin} &> {log}
        """

